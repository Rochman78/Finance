# ── Shopify stores ────────────────────────────────────────────────────────────
# URL format: https://your-store.myshopify.com  (no trailing slash)
# Token: Shopify Admin API access token

SHOPIFY_LFC_URL=
SHOPIFY_LFC_TOKEN=

SHOPIFY_LVO_URL=
SHOPIFY_LVO_TOKEN=

SHOPIFY_UNI_URL=
SHOPIFY_UNI_TOKEN=

SHOPIFY_TAR_URL=
SHOPIFY_TAR_TOKEN=

SHOPIFY_HET_URL=
SHOPIFY_HET_TOKEN=

SHOPIFY_RED_URL=
SHOPIFY_RED_TOKEN=

SHOPIFY_COCO_URL=
SHOPIFY_COCO_TOKEN=

SHOPIFY_MON_URL=
SHOPIFY_MON_TOKEN=

SHOPIFY_RETE_URL=
SHOPIFY_RETE_TOKEN=

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Sheet ID: the long ID in the Google Sheets URL
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=

# Service account email (from the JSON key file)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key (from the JSON key file — keep the -----BEGIN/END----- lines)
# In GitHub Secrets the value is stored as-is; \n in the key are handled automatically.
GOOGLE_PRIVATE_KEY=
