# ============================================================
# Mollie → PennyLane — Variables d'environnement
# Copier ce fichier en .env pour le développement local
# ============================================================

# Mollie
MOLLIE_API_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify (un seul store — celui lié à Mollie)
SHOPIFY_STORE_URL=mon-filet-de-camouflage.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PennyLane
PENNYLANE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL (fourni automatiquement par Render sous DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Devis / Quotes (optionnel — utilisé par createQuote.js)
# QUOTE_DEFAULT_DEADLINE_DAYS=30   → délai de validité du devis en jours

# API Devis (serveur Express — server.js)
API_SECRET_KEY=votre-cle-secrete-ici

# Options
# MODE_TEST=true     → simule les écritures PennyLane sans les créer vraiment
# RUN_ONCE=true      → exécute le job une fois et quitte (pour Render Cron Job natif)
# CRON_SCHEDULE=0 1 * * *   → cron interne si RUN_ONCE non activé
MODE_TEST=true
RUN_ONCE=false
CRON_SCHEDULE=0 1 * * *
